# ── Database (optional at demo time; DATA_MODE=memory runs fully offline) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (Kimi / Moonshot; AI_MODE=fixtures needs no key) ──
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=

# ── Modes ──
# DATA_MODE: memory | supabase
DATA_MODE=memory
# AI_MODE: live | fixtures | off
AI_MODE=fixtures
# Responses execute as dry-run unless true
RESPONSES_LIVE=false

# ── Tier 2: CI gate ──
CI_GATE_TOKEN=
