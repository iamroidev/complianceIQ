{
  "id": "leaked-secret",
  "title": "Hardcoded secret in a commit",
  "ruleId": "DEV-001",
  "domain": "code",
  "note": "A commit's scanned text carries the documented AWS example secret key (fake, from AWS docs) above the entropy threshold.",
  "steps": [
    {
      "kind": "event",
      "event": {
        "id": "evt_commit",
        "domain": "code",
        "actor": { "id": "p_owusu", "name": "A. Owusu", "role": "Developer" },
        "action": "commit_code",
        "resource": { "type": "service", "id": "svc-payments", "label": "payments-api" },
        "context": {
          "scannedText": "aws_secret_access_key = \"wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY\";"
        },
        "timestamp": "2026-02-20T10:00:00.000Z",
        "source": "git"
      }
    }
  ],
  "expected": {
    "opened": [{ "ruleId": "DEV-001", "subjectId": "svc-payments" }],
    "resolved": []
  },
  "twin": {
    "title": "Negative control: the same commit without a secret",
    "note": "Scanned text with no provider-matching secret, so no alert may fire.",
    "steps": [
      {
        "kind": "event",
        "event": {
          "id": "evt_commit",
          "domain": "code",
          "actor": { "id": "p_owusu", "name": "A. Owusu", "role": "Developer" },
          "action": "commit_code",
          "resource": { "type": "service", "id": "svc-payments", "label": "payments-api" },
          "context": { "scannedText": "refactor: move config loader to bootstrap" },
          "timestamp": "2026-02-20T10:00:00.000Z",
          "source": "git"
        }
      }
    ],
    "expected": { "opened": [], "resolved": [] }
  }
}
