      { "ruleId": "DEAD-001", "subjectId": "ob_deps_scan" },
      { "ruleId": "VEND-001", "subjectId": "v_meridian" },
      { "ruleId": "VEND-001", "subjectId": "v_cedar" }
    ],
    "resolved": [{ "ruleId": "CERT-001", "subjectId": "p_ama" }]
  },
  "twin": {
